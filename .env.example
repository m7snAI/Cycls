# =============================================================
# Etimad — environment variables (copy to .env, never commit .env)
# =============================================================
# The scraper half needs only the two SUPABASE_* vars.
# The agent half (agent/.env) needs all of the below.

# --- Shared: Supabase (scraper writes, agent reads) ----------
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # service_role key — bypasses RLS, keep secret

# --- Agent only (agent/.env) ---------------------------------
ANTHROPIC_API_KEY=sk-ant-...           # Claude model for the chat agent
CYCLS_API_KEY=...                      # Cycls deploy/auth
CRON_SECRET=...                        # guards POST /cron/daily-brief and signs unsub tokens
RESEND_API_KEY=re_...                  # Resend — sends the daily brief email
EMAIL_FROM=Etimad <brief@etimad-tender.cycls.ai>   # optional; sensible default per environment
PUBLIC_URL=https://etimad-tender.cycls.ai     # optional; base for unsubscribe links
